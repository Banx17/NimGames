PORT=3001

# Allowed CORS origin for the deployed frontend.
# Set this in Render to https://nim-games.vercel.app
FRONTEND_URL=http://localhost:3000

# MongoDB connection string. Put the real value in .env (never here or in source code).
MONGODB_URI=

# Secret used to sign wallet-auth session tokens (JWT). Put a strong random value
# in .env (never here or in source code). On Render, set AUTH_JWT_SECRET via the dashboard.
AUTH_JWT_SECRET=

# Session token lifetime in seconds (defaults to 7 days).
# AUTH_JWT_TTL_SECONDS=